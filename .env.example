# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). Never commit .env.local.

# Project URL — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Client-side key — Settings → API Keys.
# Accepts either the legacy anon key (starts with "eyJ") or the newer
# publishable key (starts with "sb_publishable_"). Both are safe to expose
# in the browser; access is controlled entirely by the RLS policies in
# supabase/migrations/part_04_rls.sql, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only key — Settings → API Keys.
# Accepts either the legacy service_role key or the newer secret key
# (starts with "sb_secret_"). Bypasses Row Level Security entirely.
# Used only in lib/supabase/admin.ts (server-side admin-account creation).
# NEVER prefix this with NEXT_PUBLIC_, never send it to the browser, never
# commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
